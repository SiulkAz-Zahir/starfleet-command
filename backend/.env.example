# Copy this file to .env (same folder) and edit as needed.
# .env is gitignored — never commit real API keys.

# "ollama" = free, local, no key needed (default)
# "anthropic" = costs money per call, needs ANTHROPIC_API_KEY below
LLM_PROVIDER=ollama

# Only used when LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434

# Only used when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
